rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidLessonProgress(data, userId) {
      return data.keys().hasAll([
               'userId', 'lessonId', 'subjectId', 'isCompleted',
               'isBookmarked', 'userNote', 'masteryPercent', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'lessonId', 'subjectId', 'isCompleted',
               'isBookmarked', 'userNote', 'masteryPercent', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             data.lessonId is string && data.lessonId.size() >= 1 && data.lessonId.size() <= 100 &&
             data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 50 &&
             data.isCompleted is bool &&
             data.isBookmarked is bool &&
             data.userNote is string && data.userNote.size() <= 1000 &&
             data.masteryPercent is int && data.masteryPercent >= 0 && data.masteryPercent <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFlashcardProgress(data, userId) {
      return data.keys().hasAll([
               'userId', 'cardId', 'subjectId', 'leitnerBox',
               'reviewCount', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'cardId', 'subjectId', 'leitnerBox',
               'reviewCount', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             data.cardId is string && data.cardId.size() >= 1 && data.cardId.size() <= 100 &&
             data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 50 &&
             data.leitnerBox is int && data.leitnerBox >= 1 && data.leitnerBox <= 5 &&
             data.reviewCount is int && data.reviewCount >= 0 && data.reviewCount <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStudyTask(data, userId) {
      return data.keys().hasAll([
               'userId', 'title', 'subjectId', 'stageTag',
               'durationMinutes', 'isCompleted', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'title', 'subjectId', 'stageTag',
               'durationMinutes', 'isCompleted', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 300 &&
             data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 50 &&
             data.stageTag is string && data.stageTag.size() >= 1 && data.stageTag.size() <= 100 &&
             data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 600 &&
             data.isCompleted is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidExamResult(data, userId) {
      return data.keys().hasAll([
               'userId', 'subjectId', 'subjectTitle', 'correctCount',
               'totalCount', 'scorePercent', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'subjectId', 'subjectTitle', 'correctCount',
               'totalCount', 'scorePercent', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 50 &&
             data.subjectTitle is string && data.subjectTitle.size() >= 1 && data.subjectTitle.size() <= 150 &&
             data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 200 &&
             data.totalCount is int && data.totalCount >= 1 && data.totalCount <= 200 &&
             data.correctCount <= data.totalCount &&
             data.scorePercent is int && data.scorePercent >= 0 && data.scorePercent <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      match /lesson_progress/{lessonId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(lessonId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(lessonId) &&
                         incoming().lessonId == lessonId &&
                         isValidLessonProgress(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(lessonId) &&
                         isValidLessonProgress(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().lessonId == existing().lessonId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'isCompleted', 'isBookmarked', 'userNote', 'masteryPercent', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(lessonId);
      }

      match /flashcards/{cardId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(cardId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(cardId) &&
                         incoming().cardId == cardId &&
                         isValidFlashcardProgress(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(cardId) &&
                         isValidFlashcardProgress(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().cardId == existing().cardId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'leitnerBox', 'reviewCount', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(cardId);
      }

      match /study_tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(taskId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(taskId) &&
                         isValidStudyTask(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(taskId) &&
                         isValidStudyTask(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'subjectId', 'stageTag', 'durationMinutes', 'isCompleted', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(taskId);
      }

      match /exam_results/{resultId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(resultId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(resultId) &&
                         isValidExamResult(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(resultId) &&
                         isValidExamResult(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'scorePercent', 'correctCount', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(resultId);
      }
    }
  }
}
